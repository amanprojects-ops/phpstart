<?php

declare(strict_types=1);

/**
 * {{PROJECT_NAME}} - API Entry Point
 * 
 * Generated by phpstart on {{DATE}}
 * 
 * @author {{AUTHOR}}
 */

define('BASE_PATH', dirname(__DIR__));

// Load configuration
require_once BASE_PATH . '/config/config.php';
require_once BASE_PATH . '/config/database.php';

// Simple PSR-4 autoloader
spl_autoload_register(function ($class) {
    $prefix = '{{NAMESPACE}}\\';
    $baseDir = BASE_PATH . '/src/';
    
    $len = strlen($prefix);
    if (strncmp($prefix, $class, $len) !== 0) {
        return;
    }
    
    $relativeClass = substr($class, $len);
    $file = $baseDir . str_replace('\\', '/', $relativeClass) . '.php';
    
    if (file_exists($file)) {
        require $file;
    }
});

// Set JSON header globally
header('Content-Type: application/json');

// Error reporting
if (APP_ENV === 'development') {
    error_reporting(E_ALL);
    ini_set('display_errors', '0'); // Don't display, return as JSON
} else {
    error_reporting(0);
}

// Error handler
set_error_handler(function($errno, $errstr, $errfile, $errline) {
    {{NAMESPACE}}\Core\Response::error('Internal server error', 500);
});

// Exception handler
set_exception_handler(function($exception) {
    {{NAMESPACE}}\Core\Response::error($exception->getMessage(), 500);
});

// Apply CORS middleware
{{NAMESPACE}}\Core\Middleware::cors();

// Initialize router
$router = new {{NAMESPACE}}\Core\Router();

// Define API routes
$router->get('/api/users', function() {
    $controller = new {{NAMESPACE}}\Controllers\Api\UserController();
    $controller->index();
});

$router->get('/api/users/{id}', function($id) {
    $controller = new {{NAMESPACE}}\Controllers\Api\UserController();
    $controller->show((int) $id);
});

$router->post('/api/users', function() {
    $controller = new {{NAMESPACE}}\Controllers\Api\UserController();
    $controller->store();
});

$router->put('/api/users/{id}', function($id) {
    $controller = new {{NAMESPACE}}\Controllers\Api\UserController();
    $controller->update((int) $id);
});

$router->delete('/api/users/{id}', function($id) {
    $controller = new {{NAMESPACE}}\Controllers\Api\UserController();
    $controller->destroy((int) $id);
});

// Health check
$router->get('/api/health', function() {
    {{NAMESPACE}}\Core\Response::success(['status' => 'healthy', 'timestamp' => time()]);
});

// Dispatch request
$router->dispatch();
