            <div class="stat-value"><?php echo $db_stats['connected'] ? number_format($db_stats['rows']) : '—'; ?></div>
            <div class="stat-label">Total Rows</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-hard-drive"></i></div>
            <div class="stat-value"><?php echo $db_stats['connected'] ? format_bytes($db_stats['size']) : '—'; ?></div>
            <div class="stat-label">DB Size</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-box-archive"></i></div>
            <div class="stat-value"><?php echo count($backup_files); ?></div>
            <div class="stat-label">Backups</div>
        </div>
    </div>

    <!-- Create Backup -->
    <div class="panel-card">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
            <div>
                <div class="card-title"><i class="fa-solid fa-plus-circle"></i> Create Backup</div>
                <div class="card-subtitle" style="margin-bottom:0;">Export all tables from <strong><?php echo htmlspecialchars($db_name); ?></strong> as a SQL file.</div>
            </div>
            <form method="POST" action="?key=<?php echo urlencode($secret); ?>&action=create">
                <button type="submit" class="btn-primary btn-sm"><i class="fa-solid fa-download"></i> Create Backup Now</button>
            </form>
        </div>
    </div>

    <!-- Backup List -->
    <div class="panel-card">
        <div class="card-title"><i class="fa-solid fa-clock-rotate-left"></i> Backup History</div>
        <div class="card-subtitle">Max <?php echo $max_backups; ?> backups kept. Oldest auto-deleted when limit exceeded.</div>

        <?php if (empty($backup_files)): ?>
            <div class="empty-state">
                <i class="fa-solid fa-box-open"></i>
                <p>No backups yet. Click "Create Backup Now" to make your first backup.</p>
            </div>
        <?php else: ?>
            <div class="backup-list">
            <?php foreach ($backup_files as $bf): ?>
                <?php
                    $bname  = basename($bf);
                    $bsize  = format_bytes(filesize($bf));
                    $bdate  = date('M d, Y — h:i A', filemtime($bf));
                ?>
                <div class="backup-item">
                    <div class="backup-icon"><i class="fa-solid fa-file-code"></i></div>
                    <div class="backup-info">
                        <div class="backup-name"><?php echo htmlspecialchars($bname); ?></div>
                        <div class="backup-meta">
                            <span><i class="fa-regular fa-calendar"></i> <?php echo $bdate; ?></span>
                            <span><i class="fa-regular fa-hard-drive"></i> <?php echo $bsize; ?></span>
                        </div>
                    </div>
                    <div class="backup-actions">
                        <a href="?key=<?php echo urlencode($secret); ?>&action=download&file=<?php echo urlencode($bname); ?>" class="btn-outline-sm" title="Download">
                            <i class="fa-solid fa-download"></i> Download
                        </a>
                        <button type="button" class="btn-success-sm" onclick="confirmRestore('<?php echo htmlspecialchars($bname, ENT_QUOTES); ?>')" title="Restore">
                            <i class="fa-solid fa-rotate-left"></i> Restore
                        </button>
                        <button type="button" class="btn-danger-sm" onclick="confirmDelete('<?php echo htmlspecialchars($bname, ENT_QUOTES); ?>')" title="Delete">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            <?php endforeach; ?>
            </div>
        <?php endif; ?>
    </div>

    <!-- Cron Schedule -->
    <div class="panel-card">
        <div class="card-title"><i class="fa-solid fa-clock"></i> Automated Backups</div>
        <div class="card-subtitle">Set up a cron job to create backups automatically.</div>

        <div class="cron-box">
            <div class="cron-label"><i class="fa-solid fa-terminal" style="margin-right:4px;"></i> Daily backup at midnight:</div>
            <code>0 0 * * * curl -s "<?php echo htmlspecialchars($cron_url); ?>" > /dev/null 2>&1</code>
        </div>
        <div class="cron-box" style="margin-top:10px;">
            <div class="cron-label"><i class="fa-solid fa-terminal" style="margin-right:4px;"></i> Every 6 hours:</div>
            <code>0 */6 * * * curl -s "<?php echo htmlspecialchars($cron_url); ?>" > /dev/null 2>&1</code>
        </div>

        <div class="alert alert-info" style="margin-top:16px;margin-bottom:0;">
            <i class="fa-solid fa-circle-info"></i>
            <div>Add these commands to your server's crontab (<code>crontab -e</code>). On shared hosting, use the cron job manager in your control panel.</div>
        </div>
    </div>
</div>

<div class="panel-footer">
    {{PROJECT_NAME}} &nbsp;·&nbsp; Backup Panel &nbsp;·&nbsp; Generated by PHPStart
</div>

<!-- Restore Confirm Modal -->
<div class="modal-overlay" id="restoreModal">
    <div class="modal-box">
        <h3>⚠️ Restore Database?</h3>
        <p>This will <strong>overwrite all current data</strong> with the backup. This action cannot be undone.</p>
        <form method="POST" id="restoreForm" action="">
            <input type="hidden" name="file" id="restoreFile" value="">
            <div class="modal-actions">
                <button type="button" class="btn-outline-sm" onclick="closeModal('restoreModal')">Cancel</button>
                <button type="submit" class="btn-danger-sm" style="padding:9px 18px;"><i class="fa-solid fa-rotate-left"></i> Yes, Restore</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <h3>🗑️ Delete Backup?</h3>
        <p>This backup file will be permanently deleted.</p>
        <form method="POST" id="deleteForm" action="">
            <input type="hidden" name="file" id="deleteFile" value="">
            <div class="modal-actions">
                <button type="button" class="btn-outline-sm" onclick="closeModal('deleteModal')">Cancel</button>
                <button type="submit" class="btn-danger-sm" style="padding:9px 18px;"><i class="fa-solid fa-trash"></i> Yes, Delete</button>
            </div>
        </form>
    </div>
</div>

<script>
function confirmRestore(filename) {
    document.getElementById('restoreFile').value = filename;
    document.getElementById('restoreForm').action = '?key=<?php echo urlencode($secret); ?>&action=restore';
    document.getElementById('restoreModal').classList.add('active');
}

function confirmDelete(filename) {
    document.getElementById('deleteFile').value = filename;
    document.getElementById('deleteForm').action = '?key=<?php echo urlencode($secret); ?>&action=delete';
    document.getElementById('deleteModal').classList.add('active');
}

function closeModal(id) {
    document.getElementById(id).classList.remove('active');
}

// Close modal on overlay click
document.querySelectorAll('.modal-overlay').forEach(function(m) {
    m.addEventListener('click', function(e) {
        if (e.target === m) m.classList.remove('active');
    });
});

// Close on Escape
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.active').forEach(function(m) {
            m.classList.remove('active');
        });
    }
});
</script>
</body>
</html>
