}

// ─── Config ───────────────────────────────────────────────────────────────────
$db_host = _benv('DB_HOST', 'localhost');
$db_port = _benv('DB_PORT', '3306');
$db_user = _benv('DB_USERNAME', 'root');
$db_pass = _benv('DB_PASSWORD', '');
$db_name = _benv('DB_DATABASE', '{{PROJECT_NAME}}');
$max_backups = (int) _benv('BACKUP_MAX_FILES', '10');
$backup_dir  = dirname(__DIR__) . DIRECTORY_SEPARATOR . 'storage' . DIRECTORY_SEPARATOR . 'backups';

// Ensure backup directory exists
if (!is_dir($backup_dir)) {
    mkdir($backup_dir, 0755, true);
}

$alert_msg  = '';
$alert_type = '';

// ─── Database Export (Pure PHP) ───────────────────────────────────────────────
function export_database(string $host, string $user, string $pass, string $name, int $port, string $filepath): array
{
    $conn = @new mysqli($host, $user, $pass, $name, $port);
    if ($conn->connect_errno) {
        return ['success' => false, 'error' => 'Connection failed: ' . $conn->connect_error];
    }

    $conn->set_charset('utf8mb4');

    $output  = "-- ─────────────────────────────────────────────────────────\n";
    $output .= "-- Database Backup: {$name}\n";
    $output .= "-- Date: " . date('Y-m-d H:i:s') . "\n";
    $output .= "-- Generated by PHPStart Backup Panel\n";
    $output .= "-- ─────────────────────────────────────────────────────────\n\n";
    $output .= "SET NAMES utf8mb4;\n";
    $output .= "SET FOREIGN_KEY_CHECKS = 0;\n";
    $output .= "SET SQL_MODE = 'NO_AUTO_VALUE_ON_ZERO';\n\n";

    $tables = $conn->query("SHOW TABLES");
    $table_count = 0;
    $total_rows  = 0;

    while ($row = $tables->fetch_row()) {
        $table = $row[0];
        $table_count++;

        $output .= "-- ─── Table: `{$table}` ───\n";

        // DROP + CREATE
        $create = $conn->query("SHOW CREATE TABLE `{$table}`");
        $createRow = $create->fetch_row();
        $output .= "DROP TABLE IF EXISTS `{$table}`;\n";
        $output .= $createRow[1] . ";\n\n";

        // Data
        $data = $conn->query("SELECT * FROM `{$table}`");
        $rows = 0;
        if ($data && $data->num_rows > 0) {
            while ($dataRow = $data->fetch_assoc()) {
                $values = [];
                foreach ($dataRow as $v) {
                    if ($v === null) {
                        $values[] = 'NULL';
                    } else {
                        $values[] = "'" . $conn->real_escape_string($v) . "'";
                    }
                }
                $cols = array_map(function($c) { return "`{$c}`"; }, array_keys($dataRow));
                $output .= "INSERT INTO `{$table}` (" . implode(', ', $cols) . ") VALUES (" . implode(', ', $values) . ");\n";
                $rows++;
            }
            $output .= "\n";
        }
        $total_rows += $rows;
    }

    $output .= "SET FOREIGN_KEY_CHECKS = 1;\n";

    $conn->close();

    if (file_put_contents($filepath, $output) === false) {
        return ['success' => false, 'error' => 'Failed to write backup file.'];
    }

    return ['success' => true, 'tables' => $table_count, 'rows' => $total_rows];
}

// ─── Database Restore ─────────────────────────────────────────────────────────
function restore_database(string $host, string $user, string $pass, string $name, int $port, string $filepath): array
{
    if (!file_exists($filepath)) {
        return ['success' => false, 'error' => 'Backup file not found.'];
    }

    $conn = @new mysqli($host, $user, $pass, $name, $port);
    if ($conn->connect_errno) {
        return ['success' => false, 'error' => 'Connection failed: ' . $conn->connect_error];
    }

    $conn->set_charset('utf8mb4');
    $sql = file_get_contents($filepath);

    $conn->multi_query($sql);

    // Consume all results
    do {
        if ($res = $conn->store_result()) {
            $res->free();
        }
    } while ($conn->more_results() && $conn->next_result());

    $hasError = $conn->errno;
    $errorMsg = $conn->error;
    $conn->close();

    if ($hasError) {
        return ['success' => false, 'error' => 'Restore error: ' . $errorMsg];
    }

    return ['success' => true];
}

// ─── Auto-Rotate ──────────────────────────────────────────────────────────────
function auto_rotate(string $dir, int $max): void
{
    $files = glob($dir . DIRECTORY_SEPARATOR . 'backup_*.sql');
    if (count($files) <= $max) return;

    // Sort by modification time (oldest first)
    usort($files, function ($a, $b) {
        return filemtime($a) - filemtime($b);
    });

    $to_delete = count($files) - $max;
    for ($i = 0; $i < $to_delete; $i++) {
        @unlink($files[$i]);
    }
}

// ─── Get DB Stats ─────────────────────────────────────────────────────────────
function get_db_stats(string $host, string $user, string $pass, string $name, int $port): array
{
    $conn = @new mysqli($host, $user, $pass, $name, $port);
    if ($conn->connect_errno) {
        return ['connected' => false];
    }

    $tables = $conn->query("SHOW TABLE STATUS");
    $table_count = 0;
    $total_rows  = 0;
    $total_size  = 0;

    while ($row = $tables->fetch_assoc()) {
        $table_count++;
        $total_rows += (int) ($row['Rows'] ?? 0);
        $total_size += (int) ($row['Data_length'] ?? 0) + (int) ($row['Index_length'] ?? 0);
    }

    $conn->close();

    return [
        'connected' => true,
        'tables'    => $table_count,
        'rows'      => $total_rows,
        'size'      => $total_size,
    ];
}

function format_bytes(int $bytes): string
{
    if ($bytes === 0) return '0 B';
    $units = ['B', 'KB', 'MB', 'GB'];
    $i = floor(log($bytes, 1024));
    return round($bytes / pow(1024, $i), 2) . ' ' . $units[$i];
}

// ─── Handle Actions ───────────────────────────────────────────────────────────
$action = $_GET['action'] ?? '';

// Create backup
if ($action === 'create' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $filename = 'backup_' . date('Y-m-d_H-i-s') . '.sql';
    $filepath = $backup_dir . DIRECTORY_SEPARATOR . $filename;

    $result = export_database($db_host, $db_user, $db_pass, $db_name, (int) $db_port, $filepath);

    if ($result['success']) {
        auto_rotate($backup_dir, $max_backups);
        $alert_msg  = "Backup created: <strong>{$filename}</strong> ({$result['tables']} tables, {$result['rows']} rows)";
        $alert_type = 'success';
    } else {
        $alert_msg  = $result['error'];
        $alert_type = 'error';
    }
}

// Restore backup
if ($action === 'restore' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $file = basename($_POST['file'] ?? '');
    $filepath = $backup_dir . DIRECTORY_SEPARATOR . $file;

    $result = restore_database($db_host, $db_user, $db_pass, $db_name, (int) $db_port, $filepath);

    if ($result['success']) {
        $alert_msg  = "Database restored from <strong>{$file}</strong> successfully!";
        $alert_type = 'success';
    } else {
        $alert_msg  = $result['error'];
        $alert_type = 'error';
    }
}

// Delete backup
if ($action === 'delete' && $_SERVER['REQUEST_METHOD'] === 'POST') {
    $file = basename($_POST['file'] ?? '');
    $filepath = $backup_dir . DIRECTORY_SEPARATOR . $file;

    if (file_exists($filepath) && @unlink($filepath)) {
        $alert_msg  = "Backup <strong>{$file}</strong> deleted.";
        $alert_type = 'success';
    } else {
        $alert_msg  = "Failed to delete backup file.";
        $alert_type = 'error';
    }
}

// Download backup
if ($action === 'download') {
    $file = basename($_GET['file'] ?? '');
    $filepath = $backup_dir . DIRECTORY_SEPARATOR . $file;

    if (file_exists($filepath)) {
        header('Content-Type: application/sql');
        header('Content-Disposition: attachment; filename="' . $file . '"');
        header('Content-Length: ' . filesize($filepath));
        readfile($filepath);
        exit;
    }
}

// ─── List Backups ─────────────────────────────────────────────────────────────
$backup_files = glob($backup_dir . DIRECTORY_SEPARATOR . 'backup_*.sql');
usort($backup_files, function ($a, $b) {
    return filemtime($b) - filemtime($a); // newest first
});

// ─── Get DB Stats ─────────────────────────────────────────────────────────────
$db_stats = get_db_stats($db_host, $db_user, $db_pass, $db_name, (int) $db_port);

// ─── Cron command ─────────────────────────────────────────────────────────────
$cron_url = ((!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http')
    . '://' . ($_SERVER['HTTP_HOST'] ?? 'localhost')
    . dirname($_SERVER['SCRIPT_NAME'])
    . '/?key=' . urlencode($secret) . '&action=create';
?>
