session_start();

// ─── Environment File Helpers ─────────────────────────────────────────────────

function _env_path(): string
{
    return dirname(__DIR__) . DIRECTORY_SEPARATOR . '.env';
}

function read_env(): array
{
    $vars = [];
    $path = _env_path();
    if (!file_exists($path)) return $vars;
    $lines = file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        $trimmed = trim($line);
        if ($trimmed === '' || strpos($trimmed, '#') === 0) continue;
        if (strpos($line, '=') === false) continue;
        [$key, $value] = explode('=', $line, 2);
        $vars[trim($key)] = trim(trim($value), '"\'');
    }
    return $vars;
}

function write_env(array $updates): bool
{
    $path = _env_path();
    if (!file_exists($path)) {
        $content = '';
        foreach ($updates as $key => $value) {
            if (str_contains((string)$value, ' ')) $value = '"' . $value . '"';
            $content .= "$key=$value\n";
        }
        return (bool) file_put_contents($path, $content);
    }

    $lines  = file($path, FILE_IGNORE_NEW_LINES);
    $result = [];
    $done   = [];

    foreach ($lines as $line) {
        $trimmed = trim($line);
        if ($trimmed === '' || strpos($trimmed, '#') === 0 || strpos($line, '=') === false) {
            $result[] = $line;
            continue;
        }
        [$key] = explode('=', $line, 2);
        $key = trim($key);
        if (isset($updates[$key])) {
            $val = $updates[$key];
            if (str_contains((string)$val, ' ')) $val = '"' . $val . '"';
            $result[] = "$key=$val";
            $done[$key] = true;
        } else {
            $result[] = $line;
        }
    }

    // Append any new keys not already in the file
    foreach ($updates as $key => $value) {
        if (!isset($done[$key])) {
            if (str_contains((string)$value, ' ')) $value = '"' . $value . '"';
            $result[] = "$key=$value";
        }
    }

    return (bool) file_put_contents($path, implode("\n", $result) . "\n");
}

function env_get(string $key, string $default = ''): string
{
    $vars = read_env();
    return $vars[$key] ?? $default;
}

// ─── Step definitions ─────────────────────────────────────────────────────────
$steps = [
    1 => ['title' => 'Welcome',      'icon' => 'fa-hand-wave'],
    2 => ['title' => 'Requirements', 'icon' => 'fa-list-check'],
    3 => ['title' => 'Database',     'icon' => 'fa-database'],
    4 => ['title' => 'Site Config',  'icon' => 'fa-gear'],
    5 => ['title' => 'Finish',       'icon' => 'fa-party-horn'],
];

$current_step = isset($_GET['step']) ? (int) $_GET['step'] : 1;
$current_step = max(1, min(5, $current_step));

$error   = '';
$success = '';

// ─── Process POST ─────────────────────────────────────────────────────────────

/* Step 3: Test & save DB config */
if ($_SERVER['REQUEST_METHOD'] === 'POST' && $current_step === 3) {
    $db_host = trim($_POST['db_host'] ?? 'localhost');
    $db_port = trim($_POST['db_port'] ?? '3306');
    $db_user = trim($_POST['db_user'] ?? 'root');
    $db_pass = trim($_POST['db_pass'] ?? '');
    $db_name = trim($_POST['db_name'] ?? '{{PROJECT_NAME}}');
    $import  = isset($_POST['import_sql']);

    // Test connection
    $conn = @new mysqli($db_host, $db_user, $db_pass, '', (int) $db_port);
    if ($conn->connect_errno) {
        $error = 'Cannot connect to MySQL: ' . $conn->connect_error;
    } else {
        // Create DB if not exists
        $conn->query("CREATE DATABASE IF NOT EXISTS `{$db_name}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");
        $conn->select_db($db_name);

        // Import SQL if requested
        if ($import) {
            $sql_dir  = dirname(__DIR__) . DIRECTORY_SEPARATOR . 'database';
            $sql_file = null;

            // Auto-detect SQL files
            if (is_dir($sql_dir)) {
                $files = glob($sql_dir . DIRECTORY_SEPARATOR . '*.sql');
                if (!empty($files)) {
                    $sql_file = $files[0]; // Use first .sql found
                }
                // Also check subdirectories
                if (!$sql_file) {
                    $subdirs = glob($sql_dir . DIRECTORY_SEPARATOR . '*', GLOB_ONLYDIR);
                    foreach ($subdirs as $sub) {
                        $subFiles = glob($sub . DIRECTORY_SEPARATOR . '*.sql');
                        if (!empty($subFiles)) {
                            $sql_file = $subFiles[0];
                            break;
                        }
                    }
                }
            }

            if ($sql_file && file_exists($sql_file)) {
                $sql = file_get_contents($sql_file);
                $conn->multi_query($sql);

                // Consume all results
                do {
                    if ($res = $conn->store_result()) {
                        $res->free();
                    }
                } while ($conn->more_results() && $conn->next_result());

                if ($conn->errno) {
                    $error = 'SQL import had some issues (tables may already exist — that is OK).';
                } else {
                    $success = 'Database tables imported successfully!';
                }
            } elseif ($import) {
                $error = 'No SQL file found in database/ directory. You can import manually later.';
            }
        }

        if (empty($error) || strpos($error, 'already exist') !== false) {
            // Write to .env
            write_env([
                'DB_HOST'       => $db_host,
                'DB_PORT'       => $db_port,
                'DB_DATABASE'   => $db_name,
                'DB_USERNAME'   => $db_user,
                'DB_PASSWORD'   => $db_pass,
                'DB_CONNECTION' => 'mysql',
                'DB_CHARSET'    => 'utf8mb4',
            ]);

            $_SESSION['install_db_host'] = $db_host;
            $_SESSION['install_db_name'] = $db_name;
            $_SESSION['install_db_user'] = $db_user;

            header('Location: ?step=4');
            exit;
        }
    }
}

/* Step 4: Save site config */
if ($_SERVER['REQUEST_METHOD'] === 'POST' && $current_step === 4) {
    $site_url  = rtrim(trim($_POST['site_url'] ?? ''), '/');
    $site_name = trim($_POST['site_name'] ?? '{{PROJECT_NAME}}');
    $timezone  = trim($_POST['timezone'] ?? 'UTC');

    write_env([
        'APP_NAME'     => $site_name,
        'APP_URL'      => $site_url,
        'APP_TIMEZONE' => $timezone,
    ]);

    $_SESSION['install_site_url']  = $site_url;
    $_SESSION['install_site_name'] = $site_name;

    // Write lock file
    file_put_contents(__DIR__ . '/install.lock', json_encode([
        'installed_at' => date('Y-m-d H:i:s'),
        'project'      => '{{PROJECT_NAME}}',
        'php_version'  => PHP_VERSION,
    ], JSON_PRETTY_PRINT));

    header('Location: ?step=5');
    exit;
}

// ─── Check requirements ───────────────────────────────────────────────────────
function check_requirements(): array
{
    $project_root = dirname(__DIR__);
    $checks = [];
    $checks['PHP >= 8.1']             = version_compare(PHP_VERSION, '8.1.0', '>=');
    $checks['MySQLi Extension']       = extension_loaded('mysqli');
    $checks['PDO Extension']          = extension_loaded('pdo');
    $checks['PDO MySQL Driver']       = extension_loaded('pdo_mysql');
    $checks['JSON Extension']         = extension_loaded('json');
    $checks['Session Support']        = function_exists('session_start');
    $checks['File Uploads Enabled']   = (bool) ini_get('file_uploads');
    $checks['.env File Writable']     = is_writable($project_root . '/.env') || (!file_exists($project_root . '/.env') && is_writable($project_root));
    $checks['config/ Dir Writable']   = !is_dir($project_root . '/config') || is_writable($project_root . '/config');
    $checks['storage/ Dir Writable']  = !is_dir($project_root . '/storage') || is_writable($project_root . '/storage');
    return $checks;
}

$requirements = check_requirements();
$all_pass = !in_array(false, $requirements);

// ─── Detect base URL ──────────────────────────────────────────────────────────
function detect_base_url(): string
{
    $protocol = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
    $host     = $_SERVER['HTTP_HOST'] ?? 'localhost';
    $script   = dirname(dirname($_SERVER['SCRIPT_NAME']));
    $script   = rtrim($script, '/');
    return $protocol . '://' . $host . $script;
}

$detected_url = detect_base_url();

// ─── Detect SQL files ─────────────────────────────────────────────────────────
function detect_sql_files(): array
{
    $sql_dir = dirname(__DIR__) . DIRECTORY_SEPARATOR . 'database';
    $found = [];
    if (!is_dir($sql_dir)) return $found;

    $files = glob($sql_dir . DIRECTORY_SEPARATOR . '*.sql');
    foreach ($files as $f) {
        $found[] = basename($f);
    }
    // Check subdirectories
    $subdirs = glob($sql_dir . DIRECTORY_SEPARATOR . '*', GLOB_ONLYDIR);
    foreach ($subdirs as $sub) {
        $subFiles = glob($sub . DIRECTORY_SEPARATOR . '*.sql');
        foreach ($subFiles as $f) {
            $found[] = basename(dirname($f)) . '/' . basename($f);
        }
    }
    return $found;
}

$sql_files   = detect_sql_files();
$has_sql     = !empty($sql_files);

// ─── Common timezones ─────────────────────────────────────────────────────────
$timezones = [
    'UTC', 'Asia/Kolkata', 'Asia/Karachi', 'Asia/Dhaka', 'Asia/Dubai',
    'Asia/Shanghai', 'Asia/Tokyo', 'Asia/Singapore',
    'Europe/London', 'Europe/Paris', 'Europe/Berlin',
    'America/New_York', 'America/Chicago', 'America/Los_Angeles',
    'Australia/Sydney', 'Pacific/Auckland',
];
